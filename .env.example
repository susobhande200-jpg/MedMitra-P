# Keep real values in local .env or your hosting provider's secret configuration.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
TIME_ZONE=Asia/Kolkata

# Optional SMTP email delivery
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=MedMitra <noreply@example.com>

# Local development: True disables HTTPS redirect and secure-only cookies.
# Set DJANGO_DEBUG=False on the production host and serve the site over HTTPS.

# Optional Razorpay online payment integration (test keys for development).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
